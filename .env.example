# ---------------------------------------------------------------------------
# DocuAsk configuration -- copy to .env and edit.
#     Windows PowerShell:  Copy-Item .env.example .env
#     Ubuntu / macOS:      cp .env.example .env
# .env is gitignored. Never put secrets in .env.example.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=DocuAsk
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Security --------------------------------------------------------------
# CORS origins allowed to read responses from this server, comma-separated.
# Leave empty (the default) to deny ALL cross-origin access -- correct for the
# bundled UI, which is served from this same process and needs no CORS.
# Only list origins you control; '*' is rejected at startup, as is any value
# with a path, query, fragment or credentials.
# ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# --- Storage ---------------------------------------------------------------
# Everything the app writes (uploads, SQLite DB, vector store) lives here.
DATA_DIR=data
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=2000
# A PDF whose extracted text is shorter than this is treated as scanned /
# image-only and rejected (no OCR in the MVP).
MIN_EXTRACTABLE_CHARS=40

# --- Retrieval / chunking --------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
# A nearest-neighbour search always returns TOP_K chunks, relevant or not. Hits
# scoring below this cosine similarity are dropped, which is what lets the app
# answer "I found nothing" instead of feeding the model noise. Measured on the
# built-in evaluation corpus: any value in [0.15, 0.40] kept hit-rate at 10/10
# while rejecting all 3 out-of-corpus questions; 0.0 rejected none and 0.5 cut
# hit-rate to 4/10. A real-book eval (Adam Smith, Wealth of Nations: 1,584 pages,
# 4,180 chunks) later confirmed 0.30 is the best floor on both corpora -- junk
# questions now abstain at zero hit-rate cost. 0.0 returns pure noise; 0.5 drops
# hit-rate to 1/10. Raise it only after re-running the evaluation on your corpus.
RETRIEVAL_MIN_SIMILARITY=0.30
# Hard budget for the retrieved context pasted into the prompt (characters).
# Keep it comfortably below what LLM_CONTEXT_WINDOW can hold: Ollama truncates
# an oversized prompt silently.
MAX_CONTEXT_CHARS=4000
# Length of the excerpt returned with each cited source.
SOURCE_SNIPPET_CHARS=240

# --- Generation ------------------------------------------------------------
CHAT_TEMPERATURE=0.1
# Upper bound on generated tokens (Ollama's num_predict).
CHAT_MAX_TOKENS=512
# Sent to Ollama as num_ctx. Ollama's own default is 4096 tokens (2048 in some
# versions) and it truncates silently past that, so it is pinned here.
LLM_CONTEXT_WINDOW=4096
# How long Ollama keeps the model resident after a request. Without this, the
# first question after a few idle minutes pays the model-load cost again.
LLM_KEEP_ALIVE=5m

# --- Embeddings (local, CPU) ----------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Load the model in a background thread at startup. The first encode() call has
# a one-time ~35 s initialisation cost on CPU; warming up hides it. Set to false
# to keep startup instant (the cost then lands on the first upload instead).
EMBEDDING_WARMUP=true

# --- Local LLM (Ollama) ----------------------------------------------------
# NOTE: no model is hard-coded anywhere in the code; these three values are
# the only place the model is chosen. Leave OLLAMA_MODEL empty and /health
# will report the model as unconfigured instead of guessing.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_HEALTH_TIMEOUT_SECONDS=3

# --- Optional: hard offline mode ------------------------------------------
# The embedding model is fetched once from Hugging Face, then cached. Export
# HF_HUB_OFFLINE=1 (uncomment below) on a machine where the model is already
# cached to guarantee the process makes no network calls at all.
# HF_HUB_OFFLINE=1
